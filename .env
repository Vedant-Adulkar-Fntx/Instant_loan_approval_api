# =============================================================================
# NTC CredRisk score API — deployment environment
# =============================================================================
# No secrets are required for this service (stateless scoring, no database).
# Weights default from scoring_weights.json beside the app module.
#
# Start the API (after pip install -r requirements.txt):
#   uvicorn ntc_score_api:app --host "${HOST}" --port "${PORT}"
# =============================================================================

# Bind address. Use 0.0.0.0 in containers so the port is reachable externally.
HOST=0.0.0.0

# HTTP listen port (match EXPOSE / Service targetPort / ingress backend).
PORT=8000

# Flush Python stdout/stderr immediately (recommended for containers and log aggregation).
PYTHONUNBUFFERED=1
